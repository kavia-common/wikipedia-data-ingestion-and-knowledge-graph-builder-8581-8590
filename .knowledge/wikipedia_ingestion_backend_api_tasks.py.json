{"is_source_file": true, "format": "Python", "description": "This file manages background task handling for ingestion jobs in a Django application. It provides lazy initialization of a ThreadPoolExecutor for running ingestion pipelines asynchronously, supports synchronous fallback via environment variables, and ensures proper cleanup of resources. Key functions include submitting jobs to the executor, running jobs inline if needed, and managing the executor's lifecycle with thread safety and connection management.", "external_files": ["django.db.connection", "api.models.IngestionJob", "api.services.pipeline_orchestrator.run_job_pipeline", "api.utils.logging.get_logger"], "external_methods": ["IngestionJob.objects.get", "run_job_pipeline", "connection.close", "get_logger"], "published": ["submit_ingestion_job"], "classes": [], "methods": [{"name": "int _get_max_workers()", "description": "Reads and parses the MAX_WORKERS environment variable to determine the size of the thread pool, defaults to 4 if invalid.", "scope": "", "scopeKind": ""}, {"name": "bool _use_sync_ingest()", "description": "Checks the USE_SYNC_INGEST environment variable to determine if ingestion should run synchronously.", "scope": "", "scopeKind": ""}, {"name": "Optional[ThreadPoolExecutor] _ensure_executor()", "description": "Initializes and returns the global ThreadPoolExecutor if not already initialized and if async mode is enabled.", "scope": "", "scopeKind": ""}, {"name": "_shutdown_executor()", "description": "Attempts to gracefully shut down the global executor on application exit.", "scope": "", "scopeKind": ""}, {"name": "OrchestratorResult _run_pipeline_closing_connection(job_id: int)", "description": "Runs the ingestion pipeline for a given job ID, ensuring database connections are closed after execution.", "scope": "", "scopeKind": ""}, {"name": "Tuple[Optional[Future],str] submit_ingestion_job(job: IngestionJob)", "description": "Public function that queues an ingestion job for backgr