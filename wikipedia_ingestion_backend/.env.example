# Django and server configuration
DJANGO_SECRET_KEY=change-me # Required: Set a strong secret for production
DEBUG=True                 # True/False
ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver  # Comma-separated list

# Neo4j connection (required for ingestion workflow)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# LLM / Embeddings selection
# Options examples:
#   LLM_PROVIDER: openai, ollama, azure-openai, anthropic, etc.
#   EMBEDDINGS_PROVIDER: sentence-transformers, openai, ollama, etc.
LLM_PROVIDER=
EMBEDDINGS_PROVIDER=

# Only required if using OpenAI-based models
OPENAI_API_KEY=

# RAG processing defaults
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Networking / concurrency
REQUEST_TIMEOUT=60
MAX_WORKERS=4

# Notes:
# - Copy this file to ".env" and fill in appropriate values.
# - Do not commit your actual .env to source control.
# - SQLite remains the default Django DB for metadata; Neo4j is used for graph storage.
