# Django runtime
DJANGO_SECRET_KEY=please-change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Neo4j connection (required for ingestion to succeed)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Embeddings configuration
# sentence-transformers (local, default) OR openai
EMBEDDINGS_PROVIDER=sentence-transformers
# For OpenAI provider only:
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# RAG chunking and timeouts
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
REQUEST_TIMEOUT=60

# Background ingestion
MAX_WORKERS=4
# USE_SYNC_INGEST=true

# Docs generation helpers (optional)
# SITE_HOST=localhost:8000
# SITE_SCHEME=http
